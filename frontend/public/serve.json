{
  "rewrites": [
    { "source": "/guides/:slug([a-z0-9-]+)", "destination": "/guides/:slug/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/bill", "destination": "/bill/index.html" },
    { "source": "/summary", "destination": "/summary/index.html" },
    { "source": "/reports", "destination": "/reports/index.html" },
    { "source": "/settings", "destination": "/settings/index.html" },
    { "source": "/help", "destination": "/help/index.html" },
    { "source": "/tools/whatsapp-reminder", "destination": "/tools/whatsapp-reminder/index.html" },
    { "source": "/customer/:id", "destination": "/app-shell.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
