[Unit]
Description=DoAide Khata Web (serve built frontend)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/DoAide-Khata/frontend
ExecStart=/usr/bin/npx serve -s dist -l tcp://172.18.0.1:3102 --no-clipboard
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
