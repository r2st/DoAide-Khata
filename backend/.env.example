PORT=3101
SITE_URL=https://khata.doaide.com
# Backend only — never expose to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Google OAuth web client ID (public); enables optional sign-in + sync.
GOOGLE_CLIENT_ID=
# Random 32+ byte hex; required in production so sessions survive restarts.
SESSION_SECRET=
KHATA_DB_PATH=./khata.db
# Optional Unicode TTF (e.g. NotoSans-Regular.ttf) so PDFs render ₹ and Hindi names.
KHATA_PDF_FONT=
CORS_ORIGINS=http://localhost:3102,https://khata.doaide.com
